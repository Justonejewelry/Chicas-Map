#!/usr/bin/env bash
# Start Mission Control as a desktop (Electron) app — Mail, live git, Actions.
set -e
cd "$(dirname "$0")"
if ! command -v node >/dev/null 2>&1; then
  echo "Node.js 18+ is required. Install from https://nodejs.org"
  exit 1
fi
echo "Starting desktop Mission Control…"
exec npm run start:desktop
