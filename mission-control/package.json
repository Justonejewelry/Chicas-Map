{
  "name": "chica-mission-control",
  "version": "0.3.2",
  "private": true,
  "description": "Local-first operations center for Chicas Map — Garage Sale Intelligence Network",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/launch.mjs",
    "start:desktop": "node scripts/launch.mjs --desktop",
    "dev": "vite --open",
    "dev:electron": "node scripts/launch.mjs --desktop",
    "build": "vite build",
    "build:mac": "vite build && electron-builder --mac",
    "preview": "vite preview",
    "postinstall": "node -e \"console.log('\\n  Ready. Run:  npm start\\n  Desktop: npm run start:desktop\\n')\""
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "8.2.2",
    "electron": "31.7.7",
    "electron-builder": "24.13.3",
    "vite": "5.4.14",
    "wait-on": "7.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.chicasmap.missioncontrol",
    "productName": "Chica Mission Control",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  }
}
