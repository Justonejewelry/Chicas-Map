{
  "name": "chica-mission-control",
  "version": "0.3.0",
  "private": true,
  "description": "Local-first operations center for Chicas Map — Garage Sale Intelligence Network",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "build:mac": "vite build && electron-builder --mac --x64 --arm64",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "8.2.2",
    "cross-env": "7.0.3",
    "electron": "31.7.7",
    "electron-builder": "24.13.3",
    "vite": "5.4.14",
    "wait-on": "7.2.0"
  },
  "build": {
    "appId": "com.chicasmap.missioncontrol",
    "productName": "Chica Mission Control",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": ["dmg"],
      "arch": ["x64", "arm64"],
      "category": "public.app-category.developer-tools"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  }
}
