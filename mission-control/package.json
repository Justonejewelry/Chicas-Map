{
  "name": "chica-mission-control",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Mac operations center for Chicas Map",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build && electron-builder --mac --x64",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.chicasmap.missioncontrol",
    "productName": "Chica Mission Control",
    "mac": {
      "target": ["dmg"],
      "arch": ["x64"]
    },
    "files": ["dist/**/*", "electron/**/*", "package.json"]
  }
}
